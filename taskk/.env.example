# =============================================================================
# Distributed Task Queue – Environment Configuration
# =============================================================================
# Copy this file to .env and adjust values for your environment.
# Never commit .env to version control.
# =============================================================================

# -----------------------------------------------------------------------------
# Redis Connection
# -----------------------------------------------------------------------------
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0
# REDIS_PASSWORD=your-strong-password-here   # uncomment in production

# Connection pool
REDIS_MAX_CONNECTIONS=20
REDIS_SOCKET_TIMEOUT=5

# -----------------------------------------------------------------------------
# Worker Settings
# -----------------------------------------------------------------------------
MAX_RETRIES=3                  # Retry attempts before sending to dead-letter queue
RETRY_DELAY_BASE=2             # Base seconds for exponential back-off (2, 4, 8 …)
TASK_TIMEOUT=300               # Max seconds a single task may run (5 minutes)
WORKER_POLL_INTERVAL=1         # Seconds to sleep when queue is empty

# -----------------------------------------------------------------------------
# Heartbeat
# -----------------------------------------------------------------------------
HEARTBEAT_INTERVAL=10          # Seconds between worker heartbeat writes
WORKER_TIMEOUT=30              # Seconds of silence before a worker is considered dead

# -----------------------------------------------------------------------------
# Logging
# -----------------------------------------------------------------------------
LOG_LEVEL=INFO                 # DEBUG | INFO | WARNING | ERROR | CRITICAL
LOG_FORMAT=text                # text | json  (use json for log aggregators)
# LOG_FILE=logs/taskq.log      # Uncomment to enable rotating file logging
# LOG_FILE_MAX_BYTES=10485760  # 10 MB per file (default)
# LOG_FILE_BACKUP_COUNT=5      # Keep up to 5 rotated log files

# -----------------------------------------------------------------------------
# Result Storage
# -----------------------------------------------------------------------------
RESULT_TTL=86400               # Seconds to keep task results in Redis (24 hours)

# -----------------------------------------------------------------------------
# Idempotency
# -----------------------------------------------------------------------------
IDEMPOTENCY_TTL=86400          # Deduplication window in seconds (24 hours)

# -----------------------------------------------------------------------------
# Metrics
# -----------------------------------------------------------------------------
ENABLE_METRICS=true            # Set to false to disable Redis metric counters
METRICS_TTL=86400              # Seconds to retain metric counters (24 hours)

# -----------------------------------------------------------------------------
# Web Dashboard
# -----------------------------------------------------------------------------
DASHBOARD_HOST=127.0.0.1       # Use 0.0.0.0 inside Docker
DASHBOARD_PORT=5000
